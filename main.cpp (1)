        out << members[i].id << "|" << members[i].householdId << "|" << members[i].name << "|" << members[i].role << "\n";
}

void savePets() {
    ofstream out(PETS_FILE.c_str());
    for (int i = 0; i < pets.size(); i++) {
        Pet &p = pets[i];
        out << p.id << "|" << p.householdId << "|" << p.name << "|"<< p.species << "|" << p.breed << "|" << p.age << "|" << p.hunger << "|" << p.happiness<< "|" << p.cleanliness << "|" << p.energy << "|" << p.health << "|" << p.trainLevel << "\n";
    }
}

void saveSupplies() {
    ofstream out(SUPPLIES_FILE.c_str());
    for (int i = 0; i < supplies.size(); i++)
        out << supplies[i].householdId << "|" << supplies[i].itemId << "|" << supplies[i].quantity << "\n";
}

void saveAdoptablePets() {
    ofstream out(ADOPTABLE_PETS_FILE.c_str());
    for (int i = 0; i < adoptablePets.size(); i++) {
        AdoptablePet &a = adoptablePets[i];
        out << a.id << "|" << a.name << "|" << a.species << "|" << a.breed << "|" << a.age << "|"<< a.price << "|" << (a.adopted ? 1 : 0) << "\n";
    }
}

void saveEconomy() {
    ofstream out(ECONOMY_FILE.c_str());
    out << "startingCoins|" << startingCoins << "\n";
}

void saveSettings() {
    ofstream out(SETTINGS_FILE.c_str());
    out << "nextHouseholdId|" << nextHouseholdId << "\nnextMemberId|" << nextMemberId<< "\nnextPetId|" << nextPetId << "\nnextCareLogId|" << nextCareLogId<< "\nnextAdoptionLogId|" << nextAdoptionLogId << "\n";
}

void appendCareLog(int petId, const string &action, const string &details) {
    ofstream out(CARE_LOG_FILE.c_str(), ios::app);
    out << nextCareLogId << "|" << petId << "|" << action << "|" << details << "\n";
    nextCareLogId++;
}

void appendAdoptionLog(int adoptId, int householdId, int price) {
    ofstream out(ADOPTION_LOG_FILE.c_str(), ios::app);
    out << nextAdoptionLogId << "|" << adoptId << "|" << householdId << "|" << price << "\n";
    nextAdoptionLogId++;
}

void saveAll() {
    saveHouseholds(); saveMembers(); savePets(); saveSupplies(); saveAdoptablePets(); saveEconomy(); saveSettings();
}

void loadAll() {
    ofstream(HOUSEHOLDS_FILE.c_str(), ios::app).close();
    ofstream(MEMBERS_FILE.c_str(), ios::app).close();
    ofstream(PETS_FILE.c_str(), ios::app).close();
    ofstream(SUPPLIES_FILE.c_str(), ios::app).close();
    ofstream(CARE_LOG_FILE.c_str(), ios::app).close();
    ofstream(ADOPTION_LOG_FILE.c_str(), ios::app).close();
    catBreeds = loadWordList(CAT_BREEDS_FILE);
    dogBreeds = loadWordList(DOG_BREEDS_FILE);
    loadAdoptablePets();
    loadShopItems();
    loadEconomy();
    loadSettings();
    loadHouseholds();
    loadMembers();
    loadPets();
    loadSupplies();
    cout << "Data loaded from Data/\n";
}

