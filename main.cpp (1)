// pet management
string chooseBreed(string species) {
    vector<string> *list = (species == "Cat") ? &catBreeds : &dogBreeds;
    if (list->empty()) return readLine("Breed name: ");
    cout << "  " << species << " breeds:\n";
    for (int i = 0; i < list->size(); i++) cout << "    " << (i + 1) << ". " << (*list)[i] << "\n";
    int choice = readInt("Pick a breed: ", 1, (int)list->size());
    return (*list)[choice - 1];
}

void addPet() {
    header("Add Pet");
    int hid = pickHousehold("Household ID for this pet: ");
    if (hid == -1) return;
    string name = readLine("Pet name: ");
    cout << "  1. Cat\n  2. Dog\n";
    string species = (readInt("Species: ", 1, 2) == 1) ? "Cat" : "Dog";
    string breed = chooseBreed(species);
    int age = readInt("Age (years): ", 0, 30);

    Pet p;
    p.id = nextPetId++; p.householdId = hid; p.name = name; p.species = species; p.breed = breed; p.age = age; p.hunger = 80; p.happiness = 80; p.cleanliness = 80; p.energy = 80; p.health = 100; p.trainLevel = 0; pets.push_back(p);
    cout << "  " << species << " '" << name << "' added.\n";
    saveAll();
}

void editPet() {
    header("Edit Pet");
    int id = pickPet("Pet ID to edit: ", 0);
    if (id == -1) return;
    int idx = findPetIndex(id);
    cout << "1. Rename\n2. Breed\n3. Age\n4. All\n";
    int c = readInt("Edit what: ", 1, 4);
    if (c == 1 || c == 4) pets[idx].name = readLine("New name: ");
    if (c == 2 || c == 4) pets[idx].breed = chooseBreed(pets[idx].species);
    if (c == 3 || c == 4) pets[idx].age = readInt("New age: ", 0, 30);
    cout << "  Updated.\n";
    saveAll();
}

void deletePet() {
    header("Delete Pet");
    int id = pickPet("Pet ID to delete: ", 0);
    if (id == -1) return;
    int idx = findPetIndex(id);
    string name = pets[idx].name;
    pets.erase(pets.begin() + idx);
    cout << "  Removed " << name << ".\n";
    saveAll();
}

