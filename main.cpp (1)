// pet care
bool useSupply(int hid, int itemId) {
    int idx = findSupplyIndex(hid, itemId);
    if (idx == -1 || supplies[idx].quantity <= 0) return false;
    supplies[idx].quantity--;
    return true;
}

void feedPet() {
    header("Feed a Pet");
    int id = pickPet("Pet ID to feed: ", 0);
    if (id == -1) return;
    Pet &p = pets[findPetIndex(id)];
    bool used = useSupply(p.householdId, 1);
	if (!used) {
    	cout << "You don't have any Basic Food. Buy some from the shop first.\n";
    	return;
	}
	p.hunger = clampStat(p.hunger + 25, 0, 100);
	cout << "Fed with Basic Food. Hunger now "<< p.hunger << "/100.\n";
	appendCareLog(id, "Feed", "Used Basic Food");
	saveAll();
}

void playWithPet() {
