void printSuppliesTable(int hid) {
    cout << left << setw(20) << "Item" << setw(10) << "Qty" << "\n";
    int shown = 0;
    for (int i = 0; i < supplies.size(); i++) {
        if (supplies[i].householdId != hid || supplies[i].quantity <= 0) continue;
        int idx = findShopItemIndex(supplies[i].itemId);
        cout << left << setw(20) << (idx == -1 ? "Unknown" : shopItems[idx].name) << setw(10) << supplies[i].quantity << "\n";
        shown++;
    }
    if (shown == 0) cout << "  (nothing owned)\n";
}

int pickHousehold(string prompt) {
    if (households.empty()) { cout << "  No households yet - create one first.\n"; return -1; }
    printHouseholdsTable();
    int id = readInt(prompt, 1, 1000000);
    if (findHouseholdIndex(id) == -1) { cout << "  No household with that ID.\n"; return -1; }
    return id;
}

int pickPet(string prompt, int filterHouseholdId) {
    printPetsTable(filterHouseholdId);
    if (pets.empty()) return -1;
    int id = readInt(prompt, 1, 1000000);
    int idx = findPetIndex(id);
    if (idx == -1) return -1;
    if (filterHouseholdId != 0 && pets[idx].householdId != filterHouseholdId) {
        cout << "  That pet isn't in this household.\n";
        return -1;
    }
    return id;
}

// household management 
void addHousehold() {
    header("Add Household");
    string name = readLine("Household name: ");
    Household h; h.id = nextHouseholdId++; h.name = name; h.coins = startingCoins;
    households.push_back(h);
    cout << "  Created '" << name << "' with " << h.coins << " coins.\n";
    saveAll();
}

void editHousehold() {
    header("Edit Household");
    int id = pickHousehold("Household ID to edit: ");
    if (id == -1) return;
    households[findHouseholdIndex(id)].name = readLine("New name: ");
    cout << "  Updated.\n";
    saveAll();
}

void deleteHousehold() {
    header("Delete Household");
    int id = pickHousehold("Household ID to delete: ");
    if (id == -1) return;
    if (countMembersInHousehold(id) > 0 || countPetsInHousehold(id) > 0) {
        cout << "  Can't delete - it still has members or pets. Remove those first.\n";
        return;
    }
    households.erase(households.begin() + findHouseholdIndex(id));
    cout << "  Deleted.\n";
    saveAll();
}

void householdManagementMenu() {
    while (true) {
        header("Household Management");
        cout << "1. Add\n2. Edit\n3. Delete\n4. View\n5. Back\n";
        int c = readInt("> ", 1, 5);
        if (c == 1) addHousehold();
        else if (c == 2) editHousehold();
        else if (c == 3) deleteHousehold();
        else if (c == 4) { header("Households"); printHouseholdsTable(); }
        else return;
        cout << "\nPress Enter...";
cin.get();
    }
}

// household members
void addMember() {
    header("Add Member");
    int hid = pickHousehold("Household ID for this member: ");
    if (hid == -1) return;
    string name = readLine("Member name: ");
    string role = readLine("Role (Parent, Kid, Roommate...): ");
    Member m; m.id = nextMemberId++; m.householdId = hid; m.name = name; m.role = role;
    members.push_back(m);
    cout << "  Added " << name << " to household #" << hid << ".\n";
    saveAll();
}

void editMember() {
    header("Edit Member");
    printMembersTable(0);
    if (members.empty()) return;
    int id = readInt("Member ID to edit: ", 1, 1000000);
    int idx = findMemberIndex(id);
    if (idx == -1) { cout << "  No member with that ID.\n"; return; }
    members[idx].name = readLine("New name: ");
    members[idx].role = readLine("New role: ");
    cout << "  Updated.\n";
    saveAll();
}

void deleteMember() {
    header("Delete Member");
    printMembersTable(0);
    if (members.empty()) return;
    int id = readInt("Member ID to delete: ", 1, 1000000);
    int idx = findMemberIndex(id);
    if (idx == -1) { cout << "  No member with that ID.\n"; return; }
    members.erase(members.begin() + idx);
    cout << "  Deleted.\n";
    saveAll();
}

void transferMember() {
    header("Transfer Member");
    printMembersTable(0);
    if (members.empty()) return;
    int id = readInt("Member ID to move: ", 1, 1000000);
    int idx = findMemberIndex(id);
    if (idx == -1) { cout << "  No member with that ID.\n"; return; }
    int newHid = pickHousehold("Destination household ID: ");
    if (newHid == -1) return;
    members[idx].householdId = newHid;
    cout << "  Moved to household #" << newHid << ".\n";
    saveAll();
}

void householdMembersMenu() {
    while (true) {
