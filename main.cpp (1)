// adoption center
void adoptPet() {
    header("Adopt a Pet");
    printAdoptablePetsTable();
    int id = readInt("Pet ID to adopt: ", 1, 1000000);
    int aidx = findAdoptablePetIndex(id);
    if (aidx == -1) { cout << "  No such pet.\n"; return; }
    if (adoptablePets[aidx].adopted) { cout << "  Already adopted.\n"; return; }

    int hid = pickHousehold("Household ID adopting this pet: ");
    if (hid == -1) return;
    int hidx = findHouseholdIndex(hid);
    int price = adoptablePets[aidx].price;
    if (households[hidx].coins < price) {
        cout << "  Not enough coins - costs " << price << ", household has " << households[hidx].coins << ".\n";
        return;
    }

    households[hidx].coins -= price;
    adoptablePets[aidx].adopted = true;

    Pet p;
    p.id = nextPetId++; p.householdId = hid; p.name = adoptablePets[aidx].name; p.species = adoptablePets[aidx].species; p.breed = adoptablePets[aidx].breed; p.age = adoptablePets[aidx].age; p.hunger = 70; p.happiness = 70; p.cleanliness = 70; p.energy = 70; p.health = 90; p.trainLevel = 0;
    pets.push_back(p);

    appendAdoptionLog(adoptablePets[aidx].id, hid, price);
    cout << "  " << p.name << " the " << p.breed << " joined household #" << hid << " for " << price << " coins.\n";
    saveAll();
}

