struct Household { int id, coins; string name; };
struct Member { int id, householdId; string name, role; };
struct Pet {
    int id, householdId, age;
    int hunger, happiness, cleanliness, energy, health, trainLevel;
    string name, species, breed;
};
struct ShopItem { int id, price; string name, category, effect; };
struct AdoptablePet { int id, age, price; string name, species, breed; bool adopted; };
struct SupplyEntry { int householdId, itemId, quantity; };

vector<Household> households;
vector<Member> members;
vector<Pet> pets;
vector<ShopItem> shopItems;
vector<AdoptablePet> adoptablePets;
vector<SupplyEntry> supplies;
vector<string> catBreeds;
vector<string> dogBreeds;

int nextHouseholdId = 1, nextMemberId = 1, nextPetId = 1, nextCareLogId = 1, nextAdoptionLogId = 1;
int startingCoins = 150;

void saveAll();

vector<string> splitLine(string line, char delim) {
    vector<string> out;
    string cur;
    for (int i = 0; i < line.size(); i++) {
        if (line[i] == delim) { out.push_back(cur); cur.clear(); }
        else cur += line[i];
    }
    out.push_back(cur);
    return out;
}

int toInt(string s) { return s.empty() ? 0 : atoi(s.c_str()); }

int clampStat(int v, int lo, int hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

int readInt(string prompt, int lo, int hi) {
    int v;
    while (true) {
        cout << prompt;
        cin >> v;
        if (cin.eof()) { cout << "\nInput closed, saving and exiting.\n"; saveAll(); exit(0); }
        if (cin.fail()) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "  Not a number, try again.\n";
            continue;
        }
        cin.ignore(10000, '\n');
        if (v < lo || v > hi) { cout << "  Enter a number between " << lo << " and " << hi << ".\n"; continue; }
        return v;
    }
}

string readLine(string prompt) {
    string line;
    while (true) {
        cout << prompt;
        getline(cin, line);
        if (cin.eof() && line.empty()) { cout << "\nInput closed, saving and exiting.\n"; saveAll(); exit(0); }
        if (line.empty()) { cout << "  Can't be blank.\n"; continue; }
        return line;
    }
}

int findHouseholdIndex(int id) {
    for (int i = 0; i < households.size(); i++) if (households[i].id == id) return (int)i;
    return -1;
}
int findMemberIndex(int id) {
    for (int i = 0; i < members.size(); i++) if (members[i].id == id) return (int)i;
    return -1;
}
int findPetIndex(int id) {
    for (int i = 0; i < pets.size(); i++) if (pets[i].id == id) return (int)i;
    return -1;
}
int findShopItemIndex(int id) {
    for (int i = 0; i < shopItems.size(); i++) if (shopItems[i].id == id) return (int)i;
    return -1;
}
int findAdoptablePetIndex(int id) {
    for (int i = 0; i < adoptablePets.size(); i++) if (adoptablePets[i].id == id) return (int)i;
    return -1;
}
int findSupplyIndex(int hid, int itemId) {
    for (int i = 0; i < supplies.size(); i++)
        if (supplies[i].householdId == hid && supplies[i].itemId == itemId) return (int)i;
    return -1;
}
int countPetsInHousehold(int hid) {
    int c = 0;
    for (int i = 0; i < pets.size(); i++) if (pets[i].householdId == hid) c++;
    return c;
}
int countMembersInHousehold(int hid) {
    int c = 0;
    for (int i = 0; i < members.size(); i++) if (members[i].householdId == hid) c++;
    return c;
}

vector<string> loadWordList(string path) {
    vector<string> out;
    ifstream in(path.c_str());
    string line;
    while (getline(in, line)) if (!line.empty()) out.push_back(line);
    return out;
}

void loadAdoptablePets() {
    adoptablePets.clear();
    ifstream in(ADOPTABLE_PETS_FILE.c_str()); string line;
    while (getline(in, line)) {
        if (line.empty()) continue;
        vector<string> f = splitLine(line, '|');
        if (f.size() < 7) continue;
        AdoptablePet a;
        a.id = toInt(f[0]); a.name = f[1]; a.species = f[2]; a.breed = f[3]; a.age = toInt(f[4]); a.price = toInt(f[5]); a.adopted = toInt(f[6]) != 0;
        adoptablePets.push_back(a);
    }
}

void loadShopItems() {
    shopItems.clear();
    ifstream in(SHOP_FILE.c_str()); string line;
    while (getline(in, line)) {
        if (line.empty()) continue;
        vector<string> f = splitLine(line, '|');
        if (f.size() < 5) continue;
        ShopItem s;
        s.id = toInt(f[0]); s.name = f[1]; s.category = f[2]; s.price = toInt(f[3]); s.effect = f[4]; shopItems.push_back(s);
    }
}

void loadHouseholds() {
    households.clear();
    ifstream in(HOUSEHOLDS_FILE.c_str()); string line;
    while (getline(in, line)) {
        if (line.empty()) continue;
        vector<string> f = splitLine(line, '|');
        if (f.size() < 3) continue;
        Household h; h.id = toInt(f[0]); h.name = f[1]; h.coins = toInt(f[2]); households.push_back(h);
    }
}

void loadMembers() {
    members.clear();
    ifstream in(MEMBERS_FILE.c_str()); string line;
    while (getline(in, line)) {
        if (line.empty()) continue;
        vector<string> f = splitLine(line, '|');
        if (f.size() < 4) continue;
        Member m; m.id = toInt(f[0]); m.householdId = toInt(f[1]); m.name = f[2]; m.role = f[3]; members.push_back(m);
    }
}

void loadPets() {
    pets.clear();
    ifstream in(PETS_FILE.c_str()); string line;
    while (getline(in, line)) {
        if (line.empty()) continue;
        vector<string> f = splitLine(line, '|');
        if (f.size() < 12) continue;
        Pet p;
        p.id = toInt(f[0]); p.householdId = toInt(f[1]); p.name = f[2]; p.species = f[3]; p.breed = f[4]; p.age = toInt(f[5]); p.hunger = toInt(f[6]); p.happiness = toInt(f[7]); p.cleanliness = toInt(f[8]); p.energy = toInt(f[9]); p.health = toInt(f[10]); p.trainLevel = toInt(f[11]); pets.push_back(p);
    }
}

void loadSupplies() {
    supplies.clear();
    ifstream in(SUPPLIES_FILE.c_str()); string line;
    while (getline(in, line)) {
        if (line.empty()) continue;
        vector<string> f = splitLine(line, '|');
        if (f.size() < 3) continue;
        SupplyEntry s; s.householdId = toInt(f[0]); s.itemId = toInt(f[1]); s.quantity = toInt(f[2]); supplies.push_back(s);
    }
}

void loadEconomy() {
    ifstream in(ECONOMY_FILE.c_str()); string line;
    while (getline(in, line)) {
        vector<string> f = splitLine(line, '|');
        if (f.size() >= 2 && f[0] == "startingCoins") startingCoins = toInt(f[1]);
    }
}

void loadSettings() {
    ifstream in(SETTINGS_FILE.c_str()); string line;
    while (getline(in, line)) {
        vector<string> f = splitLine(line, '|');
        if (f.size() < 2) continue;
        if (f[0] == "nextHouseholdId") nextHouseholdId = toInt(f[1]);
        else if (f[0] == "nextMemberId") nextMemberId = toInt(f[1]);
        else if (f[0] == "nextPetId") nextPetId = toInt(f[1]);
        else if (f[0] == "nextCareLogId") nextCareLogId = toInt(f[1]);
        else if (f[0] == "nextAdoptionLogId") nextAdoptionLogId = toInt(f[1]);
    }
}

void saveHouseholds() {
    ofstream out(HOUSEHOLDS_FILE.c_str());
    for (int i = 0; i < households.size(); i++)
        out << households[i].id << "|" << households[i].name << "|" << households[i].coins << "\n";
}

void saveMembers() {
    ofstream out(MEMBERS_FILE.c_str());
