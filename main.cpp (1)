using namespace std;

const string CAT_BREEDS_FILE = "Data/cat_breeds.txt";
const string DOG_BREEDS_FILE = "Data/dog_breeds.txt";
const string ADOPTABLE_PETS_FILE = "Data/adoptable_pets.txt";
