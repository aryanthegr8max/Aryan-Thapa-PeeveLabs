// shop
void buyShopItem() {
    header("Buy an Item");
    printShopTable();
    int id = readInt("Item ID: ", 1, 1000000);
    int sidx = findShopItemIndex(id);
    if (sidx == -1) { cout << "  No such item.\n"; return; }
    int hid = pickHousehold("Household ID buying: ");
    if (hid == -1) return;
    int hidx = findHouseholdIndex(hid);
    int qty = readInt("How many: ", 1, 100);
    int total = shopItems[sidx].price * qty;
    if (households[hidx].coins < total) {
        cout << "  Not enough coins - costs " << total << ", household has " << households[hidx].coins << ".\n";
        return;
    }
    households[hidx].coins -= total;
    int supIdx = findSupplyIndex(hid, id);
    if (supIdx == -1) {
        SupplyEntry s; s.householdId = hid; s.itemId = id; s.quantity = qty;
        supplies.push_back(s);
    } else {
        supplies[supIdx].quantity += qty;
    }
    cout << "  Bought " << qty << "x " << shopItems[sidx].name << " for " << total << " coins.\n";
    saveAll();
}

