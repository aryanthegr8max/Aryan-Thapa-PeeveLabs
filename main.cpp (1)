// statistics
void showStatistics() {
    header("Statistics");
    int totalCoins = 0;
    for (int i = 0; i < households.size(); i++) totalCoins += households[i].coins;

    int hunger = 0, happy = 0, clean = 0, energy = 0, health = 0, train = 0;
    int catCount = 0, dogCount = 0;
    for (int i = 0; i < pets.size(); i++) {
        hunger += pets[i].hunger; happy += pets[i].happiness; clean += pets[i].cleanliness;
        energy += pets[i].energy; health += pets[i].health; train += pets[i].trainLevel;
        if (pets[i].species == "Cat") catCount++; else if (pets[i].species == "Dog") dogCount++;
    }
    int petCount = (int)pets.size();

    cout << "Households:      " << households.size() << "\n";
    cout << "Members:         " << members.size() << "\n";
    cout << "Pets:            " << petCount << " (Cats: " << catCount << ", Dogs: " << dogCount << ")\n";
    cout << "Coins in play:   " << totalCoins << "\n";

    int adopted = 0, available = 0;
    for (int i = 0; i < adoptablePets.size(); i++) (adoptablePets[i].adopted ? adopted : available)++;
    cout << "Adopted:         " << adopted << "\n";
    cout << "Still available: " << available << "\n";
	int p=petCount;
    cout << fixed << setprecision(1);
    if (p > 0) {
        cout << "\nAverage pet stats:\n";
        cout << "  Hunger:      " << (double)hunger / p << "\n";
        cout << "  Happiness:   " << (double)happy / p << "\n";
        cout << "  Cleanliness: " << (double)clean / p << "\n";
        cout << "  Energy:      " << (double)energy / p << "\n";
        cout << "  Health:      " << (double)health / p << "\n";
        cout << "  Training:    " << (double)train / p << "\n";
    } else {
        cout << "\n(No pets yet.)\n";
    }

    if (!households.empty()) {
        int richest = 0;
        for (int i = 1; i < households.size(); i++) if (households[i].coins > households[richest].coins) richest = (int)i;
        cout << "\nRichest household: " << households[richest].name << " (" << households[richest].coins << " coins)\n";
    }
}

